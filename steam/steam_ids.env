# Steamworks App / Depot IDs for SteamPipe uploads (sourced by steam/steam_upload.sh).
# Not secret. Copy depot IDs from Steamworks > App Admin > SteamPipe > Depots.
# A blank depot ID is skipped; an app with no depot IDs at all refuses to upload.
# Steam's auto-created first depot is usually APP_ID + 1; confirm before filling in.
# Keep FULL_APP_ID / DEMO_APP_ID in step with data/project_config.gd.

FULL_APP_ID=
FULL_DEPOT_WINDOWS=
FULL_DEPOT_MAC=
FULL_DEPOT_LINUX_X64=
FULL_DEPOT_LINUX_ARM64=

DEMO_APP_ID=
DEMO_DEPOT_WINDOWS=
DEMO_DEPOT_MAC=
DEMO_DEPOT_LINUX_X64=
DEMO_DEPOT_LINUX_ARM64=
