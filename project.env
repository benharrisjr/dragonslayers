# Per-game names used by the build scripts (build.sh, steam/steam_upload.sh,
# cron/nightly_build.sh). tools/new_game.sh rewrites this file together with
# project.godot and export_presets.cfg, which must agree with it.

# File name of the exported binaries (builds/windows/$GAME_NAME.exe, ...). Must
# match the export_path entries in export_presets.cfg.
GAME_NAME="dragonslayers"

# Folder inside the rclone remote that build.sh uploads to.
GDRIVE_FOLDER_DEFAULT="dragonslayers-builds"
