extends Node
## In-game bug report / feedback. The report_bug hotkey (F7 by default, rebindable
## in Keybinds) grabs the frame on screen, then opens FeedbackPanel over
## everything. Send posts a multipart form (category, message, game context,
## screenshot, log tail) to a Cloudflare Worker relay (tools/feedback_worker),
## which rate-limits it, builds the Discord embed and forwards it to the webhook.
## The game never sees the webhook itself: it is a Worker secret.

signal submitted(ok: bool, message: String)

## Public relay endpoint (Cloudflare Worker, tools/feedback_worker), set in
## data/project_config.gd. Safe to ship; the Discord webhook itself is a Worker
## secret and never touches the game. Empty = Send stays disabled.
const FEEDBACK_ENDPOINT := ProjectConfig.FEEDBACK_ENDPOINT
## Overrides FEEDBACK_ENDPOINT when set, e.g. http://localhost:8787/report for
## `wrangler dev`.
const ENDPOINT_ENV := "FEEDBACK_ENDPOINT_OVERRIDE"
## Must match GAME_KEY in tools/feedback_worker/wrangler.toml. Not a secret
## (anyone with the .pck can read it); it just keeps drive-by bots off the
## Worker. While it is still the template placeholder the whole reporter is off.
const GAME_KEY := ProjectConfig.FEEDBACK_GAME_KEY

const CATEGORIES: Array[StringName] = [&"bug", &"feedback"]
const MAX_MESSAGE_CHARS := 2000
const LOG_TAIL_LINES := 200
const LOG_PATH := "user://logs/godot.log"
## Screenshots wider than this are halved until they fit (keeps uploads small).
const MAX_SHOT_WIDTH := 1280
## Soft client-side guard between sends; the Worker enforces the real limit.
const COOLDOWN_SEC := 60.0
const REQUEST_TIMEOUT_SEC := 20.0
## Above SceneManager's fade (100) and every HUD layer, so the form covers them.
const LAYER := 110
## The corner button: just under the form, over every other HUD layer.
const BUTTON_LAYER := 109
## The key glyph is drawn at this multiple of its 16 px pixel-art size.
const BUTTON_SCALE := 2
const BUTTON_MARGIN := 8
## Resting opacity, so the button doesn't compete with the HUD; full on hover.
const BUTTON_IDLE_ALPHA := 0.55

## 0 when the game has no demo.
const DEMO_APP_ID := ProjectConfig.STEAM_DEMO_APP_ID
## Generated by build.sh (gitignored); absent in the editor → version "dev".
const BUILD_INFO_PATH := "res://build_info.gd"

## Crash detection: each session writes its id here and deletes the file on a
## clean exit, so finding it at startup means the last session died. Its id is
## also printed into the log, which is how the last session's log is found
## among the rotated ones (headless tests rotate them too).
const SESSION_LOCK_PATH := "user://session.lock"
const SESSION_TAG := "Session: "
const LOG_DIR := "user://logs"
## Newest log files searched for the last session's id.
const CRASH_LOG_SCAN := 10
## Distinct error blocks listed at the top of a crash report's log.
const MAX_CRASH_ERRORS := 20
const _ERROR_PREFIXES: Array[String] = ["ERROR:", "SCRIPT ERROR:", "USER ERROR:", "USER SCRIPT ERROR:"]

var _layer: CanvasLayer = null
var _panel: FeedbackPanel = null
var _http: HTTPRequest = null
var _busy: bool = false
var _opening: bool = false
var _last_sent_msec: int = -1
var _button_layer: CanvasLayer = null
var _button: TextureButton = null
## Set at startup when the last session didn't exit cleanly: its errors and
## log tail (log.txt), the Discord title line, and how many errors it logged.
## Cleared once the crash report has been offered.
var _crash_log: String = ""
var _crash_headline: String = ""
var _crash_error_count: int = 0
var _tracking_session: bool = false
var _context_providers: Array[Callable] = []


func _ready() -> void:
	# The form and its request must keep running while the tree is paused.
	process_mode = Node.PROCESS_MODE_ALWAYS
	if is_enabled():
		_build_button()
		# Editor runs get stopped from the editor and headless runs are tests:
		# neither exits cleanly, and neither is a player's crash.
		if not OS.has_feature("editor") and DisplayServer.get_name() != "headless":
			_check_last_session()


## False when FeatureFlags.BUG_REPORTS is off or the game key was never set:
## no corner button, no hotkey, no crash offer.
func is_enabled() -> bool:
	return FeatureFlags.BUG_REPORTS \
			and ProjectConfig.FEEDBACK_GAME_KEY != ProjectConfig.FEEDBACK_GAME_KEY_PLACEHOLDER


func _exit_tree() -> void:
	# Autoloads leave the tree on every orderly quit; a crash never gets here.
	if _tracking_session:
		DirAccess.remove_absolute(SESSION_LOCK_PATH)


## Reads the last session's lock (if it's still there, that session crashed)
## then claims the lock for this one.
func _check_last_session() -> void:
	var crashed := FileAccess.file_exists(SESSION_LOCK_PATH)
	var last_id := FileAccess.get_file_as_string(SESSION_LOCK_PATH).strip_edges() if crashed else ""
	var session_id := "%d-%05d" % [int(Time.get_unix_time_from_system()), randi() % 100000]
	var f := FileAccess.open(SESSION_LOCK_PATH, FileAccess.WRITE)
	if f:
		f.store_string(session_id)
		f.close()
		_tracking_session = true
	print(SESSION_TAG + session_id)
	if not crashed:
		return
	var log_text := find_session_log(last_id) if last_id != "" else ""
	# The id line can be missing when the session was killed before the log
	# flushed (builds before flush_stdout_on_print, or a kill mid-buffer). The
	# newest rotated log is then almost certainly that session's.
	var guessed := false
	if log_text == "":
		log_text = find_previous_log()
		guessed = log_text != ""
	var errors := extract_errors(log_text)
	_crash_error_count = errors.size()
	_crash_headline = errors[0].get_slice("\n", 0).strip_edges() if not errors.is_empty() \
			else "no errors in the log"
	var out := PackedStringArray(["== Previous session (%s) closed unexpectedly ==" % last_id])
	if log_text == "":
		out.append("(its log wasn't found)")
	else:
		if guessed:
			out.append("(session id not in any log; using the newest previous log)")
		out.append("== Errors (%d distinct) ==" % errors.size())
		out.append("\n".join(errors.slice(0, MAX_CRASH_ERRORS)) if not errors.is_empty() else "(none)")
		var lines := log_text.split("\n")
		out.append("== Log (last %d lines) ==" % LOG_TAIL_LINES)
		out.append("\n".join(lines.slice(maxi(0, lines.size() - LOG_TAIL_LINES))))
	_crash_log = "\n".join(out) + "\n"


func has_pending_crash() -> bool:
	return _crash_log != ""


func crash_error_count() -> int:
	return _crash_error_count


## Opens the form in crash mode if the last session crashed. Once per launch:
## No Thanks drops it for good (the next crash will ask again).
func offer_crash_report() -> void:
	if not has_pending_crash() or _panel != null or _opening:
		return
	if _button_layer:
		_button_layer.visible = false
	_show_panel(null, true)


## The log of the session whose id was printed with SESSION_TAG: searched
## newest-first, since every launch (and every headless test) rotates godot.log.
static func find_session_log(session_id: String, log_dir: String = LOG_DIR) -> String:
	var dir := DirAccess.open(log_dir)
	if dir == null:
		return ""
	var files: Array[String] = []
	for name in dir.get_files():
		if name.begins_with("godot") and name.ends_with(".log"):
			files.append(log_dir.path_join(name))
	files.sort_custom(func(a: String, b: String) -> bool:
		return FileAccess.get_modified_time(a) > FileAccess.get_modified_time(b))
	var tag := SESSION_TAG + session_id
	for path in files.slice(0, CRASH_LOG_SCAN):
		var text := FileAccess.get_file_as_string(path)
		if text.contains(tag):
			return text
	return ""


## The newest rotated log (godot<timestamp>.log), i.e. the session before this
## one; godot.log itself is the current session's.
static func find_previous_log(log_dir: String = LOG_DIR) -> String:
	var dir := DirAccess.open(log_dir)
	if dir == null:
		return ""
	var newest := ""
	var newest_time := -1
	for name in dir.get_files():
		if name == "godot.log" or not name.begins_with("godot") or not name.ends_with(".log"):
			continue
		var path := log_dir.path_join(name)
		var t := FileAccess.get_modified_time(path)
		if t > newest_time:
			newest_time = t
			newest = path
	return FileAccess.get_file_as_string(newest) if newest != "" else ""


## Engine/script error blocks (the ERROR line plus its indented "at:" and
## backtrace lines), deduplicated in first-seen order, each with "(xN)" when
## it repeated.
static func extract_errors(log_text: String) -> PackedStringArray:
	var counts := {}  # block -> times seen, insertion-ordered
	var block := PackedStringArray()
	for line in log_text.split("\n"):
		if not block.is_empty() and (line.begins_with(" ") or line.begins_with("\t")):
			block.append(line)
			continue
		if not block.is_empty():
			var key := "\n".join(block)
			counts[key] = counts.get(key, 0) + 1
			block = PackedStringArray()
		for p in _ERROR_PREFIXES:
			if line.begins_with(p):
				block.append(line)
				break
	if not block.is_empty():
		var key := "\n".join(block)
		counts[key] = counts.get(key, 0) + 1
	var out := PackedStringArray()
	for key: String in counts:
		out.append(key if counts[key] == 1 else "(x%d) %s" % [counts[key], key])
	return out


## Small key-cap glyph of the report_bug key, pinned top-right: a click
## opens the form too. Shows the bound key (F7 unless rebound).
func _build_button() -> void:
	_button_layer = CanvasLayer.new()
	_button_layer.layer = BUTTON_LAYER
	_button_layer.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_button_layer)
	_button = TextureButton.new()
	_button.ignore_texture_size = true
	_button.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
	_button.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_button.focus_mode = Control.FOCUS_NONE
	_button.modulate.a = BUTTON_IDLE_ALPHA
	var side := 16 * BUTTON_SCALE
	_button.set_anchors_preset(Control.PRESET_TOP_RIGHT)
	_button.offset_left = -side - BUTTON_MARGIN
	_button.offset_top = BUTTON_MARGIN
	_button.offset_right = -BUTTON_MARGIN
	_button.offset_bottom = side + BUTTON_MARGIN
	_button.mouse_entered.connect(func() -> void: _button.modulate.a = 1.0)
	_button.mouse_exited.connect(func() -> void: _button.modulate.a = BUTTON_IDLE_ALPHA)
	_button.pressed.connect(func() -> void:
		if _panel == null and not _opening:
			open())
	_button_layer.add_child(_button)
	InfoPopup.attach(_button, "Report a Bug", "Send a bug report or feedback to the developer.",
			{"tap": false, "place": InfoPopup.Place.BELOW})
	_refresh_button()
	SaveManager.keybinds_changed.connect(_refresh_button)


func _refresh_button() -> void:
	if _button == null:
		return
	# Always the keyboard key (not the hint-toggle-aware hint_texture): the
	# button is the affordance itself, so it stays drawn with hints off too.
	var tex := Keybinds.key_texture(Keybinds.primary_keycode(&"report_bug"))
	_button.texture_normal = tex if tex else Keybinds.key_texture(KEY_F7)


func _input(event: InputEvent) -> void:
	if not is_enabled():
		return
	# The scene under the form sees _unhandled_input first (it sits after the
	# autoloads in the tree), so Escape / pad B is taken here before an Options
	# window underneath can close instead.
	if _panel and event.is_action_pressed(&"ui_cancel"):
		get_viewport().set_input_as_handled()
		_panel._on_back()
		return
	if not event.is_action_pressed(&"report_bug") or event.is_echo():
		return
	get_viewport().set_input_as_handled()
	if _panel == null and not _opening:
		open()


func is_open() -> bool:
	return _panel != null


func endpoint() -> String:
	var override := OS.get_environment(ENDPOINT_ENV)
	return override if override != "" else FEEDBACK_ENDPOINT


func is_configured() -> bool:
	return is_enabled() and endpoint() != ""


## Seconds left before another send is allowed (0 = ready).
func cooldown_left() -> float:
	if _last_sent_msec < 0:
		return 0.0
	return maxf(0.0, COOLDOWN_SEC - (Time.get_ticks_msec() - _last_sent_msec) / 1000.0)


func open() -> void:
	_opening = true
	# Capture before the form exists (and with the corner button hidden) so
	# neither is in the shot.
	if _button_layer:
		_button_layer.visible = false
	await RenderingServer.frame_post_draw
	var shot := get_viewport().get_texture().get_image()
	while shot.get_width() > MAX_SHOT_WIDTH:
		shot.resize(shot.get_width() / 2, shot.get_height() / 2, Image.INTERPOLATE_BILINEAR)
	_opening = false
	_show_panel(shot, false)


func _show_panel(shot: Image, crash: bool) -> void:
	_layer = CanvasLayer.new()
	_layer.layer = LAYER
	_layer.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_layer)
	_panel = FeedbackPanel.new()
	_panel.screenshot = shot
	_panel.crash_report = crash
	_panel.closed.connect(_close)
	_layer.add_child(_panel)


func _close() -> void:
	if _panel and _panel.crash_report:
		_clear_crash()
	if _button_layer:
		_button_layer.visible = true
	if _layer:
		_layer.queue_free()
	_layer = null
	_panel = null


func _clear_crash() -> void:
	_crash_log = ""
	_crash_headline = ""
	_crash_error_count = 0


## Sends the last session's crash: its errors and log instead of this
## session's state, titled with its first error. The player's note is optional.
func submit_crash(note: String) -> void:
	var message := "Crash: %s" % _crash_headline
	if note.strip_edges() != "":
		message += "\n\n" + note.strip_edges()
	submit(&"bug", message, null, _crash_log)


## Posts one report. Emits `submitted` exactly once per call. `log_text`
## replaces the default log.txt (report context + this session's log tail).
func submit(category: StringName, message: String, screenshot: Image, log_text: String = "") -> void:
	if _busy:
		return
	if not is_configured():
		submitted.emit(false, "Feedback isn't configured in this build.")
		return
	if cooldown_left() > 0.0:
		submitted.emit(false, "Please wait %ds before sending another." % ceili(cooldown_left()))
		return
	_busy = true

	if log_text == "":
		log_text = state_dump() + "\n== Log (last %d lines) ==\n" % LOG_TAIL_LINES + read_log_tail(LOG_TAIL_LINES)
	var boundary := "----GameFeedback%d" % Time.get_ticks_usec()
	var body := build_body(boundary, category, message, build_context(),
			screenshot.save_png_to_buffer() if screenshot else PackedByteArray(), log_text)

	_http = HTTPRequest.new()
	_http.timeout = REQUEST_TIMEOUT_SEC
	_http.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_http)
	_http.request_completed.connect(_on_request_completed)
	var headers := PackedStringArray([
		"Content-Type: multipart/form-data; boundary=" + boundary,
		"X-Game-Key: " + GAME_KEY,
	])
	var err := _http.request_raw(endpoint(), headers, HTTPClient.METHOD_POST, body)
	if err != OK:
		_finish(false, "Couldn't send (error %d)." % err)


func _on_request_completed(result: int, code: int, _headers: PackedStringArray,
		_body: PackedByteArray) -> void:
	if result != HTTPRequest.RESULT_SUCCESS:
		_finish(false, "Couldn't reach the server. Check your connection.")
	elif code == 200:
		_last_sent_msec = Time.get_ticks_msec()
		_finish(true, "Thanks! Your report was sent.")
	elif code == 429:
		_finish(false, "Too many reports. Try again in a minute.")
	else:
		_finish(false, "Couldn't send (server said %d)." % code)


func _finish(ok: bool, message: String) -> void:
	_busy = false
	if _http:
		_http.queue_free()
		_http = null
	submitted.emit(ok, message)


## multipart/form-data body. Plain fields only: the Worker owns all Discord
## formatting, so the embed can change without a game patch.
static func build_body(boundary: String, category: StringName, message: String,
		context: Dictionary, png: PackedByteArray, log_text: String) -> PackedByteArray:
	var body := PackedByteArray()
	body.append_array(_field(boundary, "category", String(category)))
	body.append_array(_field(boundary, "message", message.strip_edges().left(MAX_MESSAGE_CHARS)))
	body.append_array(_field(boundary, "context", JSON.stringify(context)))
	if not png.is_empty():
		body.append_array(_file(boundary, "screenshot", "screenshot.png", "image/png", png))
	if log_text != "":
		body.append_array(_file(boundary, "log", "log.txt", "text/plain",
				log_text.to_utf8_buffer()))
	body.append_array(("--%s--\r\n" % boundary).to_utf8_buffer())
	return body


static func _field(boundary: String, name: String, value: String) -> PackedByteArray:
	var head := "--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n" % [boundary, name]
	var out := head.to_utf8_buffer()
	out.append_array(value.to_utf8_buffer())
	out.append_array("\r\n".to_utf8_buffer())
	return out


static func _file(boundary: String, name: String, filename: String, mime: String,
		data: PackedByteArray) -> PackedByteArray:
	var head := "--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\nContent-Type: %s\r\n\r\n" \
			% [boundary, name, filename, mime]
	var out := head.to_utf8_buffer()
	out.append_array(data)
	out.append_array("\r\n".to_utf8_buffer())
	return out


## A game adds its own facts to every report by registering a provider: a
## Callable taking no arguments and returning a Dictionary of short string
## values (e.g. {"level": "3-2", "difficulty": "hard"}). They are written at
## the top of the report's log.txt; to show one in the Discord embed too, add
## its key to CONTEXT_FIELDS in tools/feedback_worker. Register once, from an
## autoload or the game scene's _ready:
##     FeedbackReporter.add_context_provider(func() -> Dictionary: return {...})
## A provider bound to a freed object is skipped and dropped.
func add_context_provider(provider: Callable) -> void:
	if not _context_providers.has(provider):
		_context_providers.append(provider)


func remove_context_provider(provider: Callable) -> void:
	_context_providers.erase(provider)


## Everything the report carries besides the player's text. Flat string values
## so the Worker can drop them straight into embed fields.
func build_context() -> Dictionary:
	var ctx := {
		"game": str(ProjectSettings.get_setting("application/config/name", "")),
		"version": version(),
		"build": build_kind(),
		"platform": "%s (%s)" % [OS.get_name(), OS.get_model_name()],
		"renderer": "%s, %s" % [RenderingServer.get_current_rendering_method(),
				RenderingServer.get_video_adapter_name()],
		"window": "%dx%d%s" % [get_window().size.x, get_window().size.y,
				" fullscreen" if get_window().mode >= Window.MODE_FULLSCREEN else ""],
		"steam": SteamManager.get_persona_name() if SteamManager.is_available() else "offline",
		"scene": _current_scene_path(),
		"input": "gamepad" if PadCursor.using_pad else "keyboard/mouse",
		"slot": str(SaveManager.current_slot),
	}
	if SaveManager.save_data:
		ctx["play_time"] = Platform.format_play_time(SaveManager.save_data.play_time_seconds)
	for provider in _context_providers.duplicate():
		if not provider.is_valid():
			_context_providers.erase(provider)
			continue
		var extra: Variant = provider.call()
		if extra is Dictionary:
			for key in extra:
				ctx[str(key)] = str(extra[key])
	return ctx


## SceneManager swaps scenes under main.tscn's root, so the tree's
## current_scene is always main.tscn; ask SceneManager for the real one.
func _current_scene_path() -> String:
	var scene: Variant = SceneManager.get(&"_current_scene")
	if scene is Node and is_instance_valid(scene) and scene.scene_file_path != "":
		return scene.scene_file_path
	return get_tree().current_scene.scene_file_path if get_tree().current_scene else ""


func version() -> String:
	if ResourceLoader.exists(BUILD_INFO_PATH):
		var info: Script = load(BUILD_INFO_PATH)
		if info and info.get_script_constant_map().has("VERSION"):
			return str(info.get_script_constant_map()["VERSION"])
	return str(ProjectSettings.get_setting("application/config/version", "dev"))


func build_kind() -> String:
	if OS.has_feature("editor"):
		return "editor"
	var app_id := OS.get_environment("SteamAppId")
	if DEMO_APP_ID > 0 and app_id == str(DEMO_APP_ID):
		return "demo"
	if app_id == str(SteamManager.APP_ID):
		return "full"
	return "standalone"


## The report context as readable lines for the top of log.txt.
func state_dump() -> String:
	var out := PackedStringArray(["== Game state =="])
	var ctx := build_context()
	for key in ctx:
		out.append("%s: %s" % [key, ctx[key]])
	return "\n".join(out) + "\n"


## Last `lines` lines of this session's Godot log, or "" when file logging is
## off (web/mobile) or the file can't be read.
static func read_log_tail(lines: int) -> String:
	if not FileAccess.file_exists(LOG_PATH):
		return ""
	var f := FileAccess.open(LOG_PATH, FileAccess.READ)
	if f == null:
		return ""
	var all := f.get_as_text().split("\n")
	return "\n".join(all.slice(maxi(0, all.size() - lines)))
