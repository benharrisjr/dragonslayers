class_name DragonAnimator
extends RefCounted

## Poses the dragon's 20-bone rig.
##
## The rig is generated by tools/convert_dragon.py, which emits geometry and a skeleton and no
## clips at all, so there is nothing to import and nothing an artist has authored. Rather than
## building Animation resources whose track paths would have to match the imported scene exactly,
## the clips live here as keyframe tables and are evaluated straight onto bone poses.
##
## That buys the thing this fight actually needs: an attack's damage has to land on the frame
## the animation looks like it lands, and a table of times in one file is where that gets tuned.
## `Dragon.ATTACKS` names a `hit_at` time that is read against these same numbers.
##
## Every clip is expressed as rotations from rest. The rest pose is the model standing square,
## so a clip that mentions no bone leaves it alone and idle breathing keeps showing through.

## Bones the fight drives. Anything not listed here is never posed.
const DRIVEN_BONES: Array[String] = [
	"hips", "spine", "chest", "neck", "head",
	"tail_1", "tail_2", "tail_3", "tail_4",
	"wing_l_root", "wing_l_mid", "wing_l_tip",
	"wing_r_root", "wing_r_mid", "wing_r_tip",
	"leg_fl", "leg_fr", "leg_bl", "leg_br",
]

## Axis conventions, stated once so the tables below read as intent rather than as arithmetic.
## The dragon faces -Z, so: X rotates head up/down and body forward/back, Y turns and sweeps
## sideways, Z raises and lowers the wings.
const PITCH := Vector3(1, 0, 0)
const YAW := Vector3(0, 1, 0)
const ROLL := Vector3(0, 0, 1)

static var _clips: Dictionary = {}


static func clip(name: String) -> Array:
	if _clips.is_empty():
		_build()
	return _clips.get(name, [])


static func duration(name: String) -> float:
	var frames := clip(name)
	return 0.0 if frames.is_empty() else float(frames[-1]["t"])


static func has(name: String) -> bool:
	if _clips.is_empty():
		_build()
	return _clips.has(name)


## The pose a clip holds at time `t`, as bone name -> Quaternion. Bones absent from the result
## are left in whatever the idle sway put them in.
static func sample(name: String, t: float) -> Dictionary:
	var frames := clip(name)
	if frames.is_empty():
		return {}
	if t <= float(frames[0]["t"]):
		return frames[0]["pose"]
	if t >= float(frames[-1]["t"]):
		return frames[-1]["pose"]

	for i in range(frames.size() - 1):
		var a: Dictionary = frames[i]
		var b: Dictionary = frames[i + 1]
		var t0: float = a["t"]
		var t1: float = b["t"]
		if t < t0 or t > t1:
			continue
		var span := maxf(0.0001, t1 - t0)
		## Smoothstep rather than linear so a wind-up eases into its held pose and the strike
		## out of it, which is most of what makes a telegraph readable.
		var k := smoothstep(0.0, 1.0, (t - t0) / span)
		return _blend(a["pose"], b["pose"], k)
	return frames[-1]["pose"]


static func _blend(from: Dictionary, to: Dictionary, k: float) -> Dictionary:
	var out := {}
	for bone: String in DRIVEN_BONES:
		var a: Quaternion = from.get(bone, Quaternion.IDENTITY)
		var b: Quaternion = to.get(bone, Quaternion.IDENTITY)
		if a == Quaternion.IDENTITY and b == Quaternion.IDENTITY:
			continue
		out[bone] = a.slerp(b, k)
	return out


static func _rot(axis: Vector3, degrees: float) -> Quaternion:
	return Quaternion(axis.normalized(), deg_to_rad(degrees))


static func _key(t: float, pose: Dictionary) -> Dictionary:
	return {"t": t, "pose": pose}


static func _wings(root: float, mid: float, tip: float) -> Dictionary:
	## Wings are mirrored on Z, so every wing pose is written once and reflected here.
	return {
		"wing_l_root": _rot(ROLL, -root), "wing_r_root": _rot(ROLL, root),
		"wing_l_mid": _rot(ROLL, -mid), "wing_r_mid": _rot(ROLL, mid),
		"wing_l_tip": _rot(ROLL, -tip), "wing_r_tip": _rot(ROLL, tip),
	}


static func _tail(a: float, b: float, c: float, d: float) -> Dictionary:
	return {
		"tail_1": _rot(YAW, a), "tail_2": _rot(YAW, b),
		"tail_3": _rot(YAW, c), "tail_4": _rot(YAW, d),
	}


static func _build() -> void:
	## --- fire breath -------------------------------------------------------------------
	## Long rear-back so a party at range has time to read it and move, then the head snaps
	## down and forward and holds while the cone burns.
	_clips["breath"] = [
		_key(0.0, {}),
		_key(0.9, {  # wind-up: head back and up, chest swells, wings half-raised
			"neck": _rot(PITCH, -34.0), "head": _rot(PITCH, -22.0),
			"chest": _rot(PITCH, -8.0),
		}.merged(_wings(26.0, 14.0, 8.0))),
		_key(1.15, {  # snap forward
			"neck": _rot(PITCH, 26.0), "head": _rot(PITCH, 18.0),
			"chest": _rot(PITCH, 6.0),
		}.merged(_wings(10.0, 6.0, 4.0))),
		_key(2.4, {  # hold while the fire pours
			"neck": _rot(PITCH, 22.0), "head": _rot(PITCH, 15.0),
			"chest": _rot(PITCH, 5.0),
		}.merged(_wings(8.0, 4.0, 2.0))),
		_key(3.0, {}),
	]

	## --- claw swipe --------------------------------------------------------------------
	## Rears onto the back legs, then rakes down and across with the front right.
	_clips["claw"] = [
		_key(0.0, {}),
		_key(0.45, {
			"hips": _rot(PITCH, -14.0), "spine": _rot(PITCH, -10.0),
			"chest": _rot(PITCH, -12.0), "neck": _rot(PITCH, -14.0),
			"leg_fr": _rot(PITCH, -70.0), "leg_fl": _rot(PITCH, -30.0),
		}.merged(_wings(30.0, 18.0, 10.0))),
		_key(0.68, {  # the rake
			"hips": _rot(PITCH, 6.0), "spine": _rot(PITCH, 5.0),
			"chest": _rot(PITCH, 10.0), "neck": _rot(PITCH, 12.0),
			"leg_fr": _rot(PITCH, 40.0), "leg_fl": _rot(PITCH, 10.0),
		}.merged(_wings(12.0, 6.0, 2.0))),
		_key(1.3, {}),
	]

	## --- tail sweep --------------------------------------------------------------------
	## Coils to one side, then whips the whole tail through the arc behind it. The wind-up is
	## deliberately long and obvious: this is the attack that throws people off the mountain.
	_clips["tail_sweep"] = [
		_key(0.0, {}),
		_key(0.85, ({"hips": _rot(YAW, 22.0), "spine": _rot(YAW, 12.0)}
				).merged(_tail(38.0, 46.0, 52.0, 56.0))),
		_key(1.15, ({"hips": _rot(YAW, -26.0), "spine": _rot(YAW, -14.0)}
				).merged(_tail(-46.0, -54.0, -60.0, -64.0))),
		_key(1.9, {}),
	]

	## --- wing flap ---------------------------------------------------------------------
	## Both wings up and then driven down hard. Short, because it is the answer to melee
	## players crowding in rather than a set-piece.
	_clips["wing_flap"] = [
		_key(0.0, {}),
		_key(0.5, {"chest": _rot(PITCH, -6.0)}.merged(_wings(-52.0, -34.0, -20.0))),
		_key(0.68, {"chest": _rot(PITCH, 8.0)}.merged(_wings(40.0, 26.0, 16.0))),
		_key(1.35, {}),
	]

	## --- roar --------------------------------------------------------------------------
	## No damage; played on aggro and when the fight resets, so the party always knows the
	## state changed even if nobody was looking at the health bar.
	_clips["roar"] = [
		_key(0.0, {}),
		_key(0.5, {"neck": _rot(PITCH, -30.0), "head": _rot(PITCH, -26.0)}
				.merged(_wings(44.0, 30.0, 22.0))),
		_key(1.4, {"neck": _rot(PITCH, -24.0), "head": _rot(PITCH, -20.0)}
				.merged(_wings(38.0, 26.0, 18.0))),
		_key(2.1, {}),
	]

	## --- death -------------------------------------------------------------------------
	## Collapses forward and rolls onto one side. Ends held, so the corpse stays down.
	_clips["death"] = [
		_key(0.0, {}),
		_key(0.6, {
			"neck": _rot(PITCH, -40.0), "head": _rot(PITCH, -30.0),
			"chest": _rot(PITCH, -14.0),
		}.merged(_wings(34.0, 22.0, 14.0))),
		_key(2.2, ({
			"hips": _rot(PITCH, 42.0), "spine": _rot(PITCH, 30.0),
			"chest": _rot(PITCH, 34.0), "neck": _rot(PITCH, 46.0),
			"head": _rot(PITCH, 30.0),
			"leg_fl": _rot(PITCH, 60.0), "leg_fr": _rot(PITCH, 60.0),
		}).merged(_wings(-16.0, -40.0, -60.0)).merged(_tail(18.0, 26.0, 30.0, 34.0))),
	]
