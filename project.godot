; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dragonslayers"
config/description="4-player online and local co-op action RPG. Kill the dragon on the mountain."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="dragonslayers"
config/project_settings_override="user://window_override.cfg"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://autoloads/save_manager.gd"
SaveIndicator="*res://autoloads/save_indicator.gd"
SceneManager="*res://autoloads/scene_manager.gd"
SoundManager="*res://autoloads/sound_manager.gd"
FontSizes="*res://autoloads/font_sizes.gd"
SelectionReticle="*res://autoloads/selection_reticle.gd"
ScreenTransitions="*res://autoloads/screen_transitions.gd"
SteamManager="*res://autoloads/steam_manager.gd"
Achievements="*res://autoloads/achievement_service.gd"
PadCursor="*res://autoloads/pad_cursor.gd"
FeedbackReporter="*res://autoloads/feedback_reporter.gd"
GameState="*res://autoloads/game_state.gd"
NetworkManager="*res://autoloads/network_manager.gd"
PlayerRegistry="*res://autoloads/player_registry.gd"
AbilityDB="*res://autoloads/ability_db.gd"
ArchetypeDB="*res://autoloads/archetype_db.gd"
MonsterDB="*res://autoloads/monster_db.gd"
RigAnimations="*res://autoloads/rig_animations.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://art/kenney_cursor-pixel-pack/Tiles/tile_0106.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://theme/default_theme.tres"

